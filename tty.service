[Unit]
Description=tty web terminal
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/opt/tty
ExecStart=$HOME/.nvm/versions/node/v22.22.1/bin/node server/dist/index.js
Restart=on-failure
RestartSec=3

Environment=PORT=3789
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/opt/tty/data
Environment=CLIENT_DIST=/opt/tty/client/dist

# Give node-pty access to a real TTY
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tty

[Install]
WantedBy=multi-user.target
